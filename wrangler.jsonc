// Your SabiVida mini app on Cloudflare Workers. Rename it and set your app id.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-sabivida-mini-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
  },
  "vars": { "SABIVIDA_HOST": "https://app.sabivida.com", "MINI_APP_ID": "your-app-id" },
}
