# Copy to .env for `npm run dev` and `npm run build`.
# The SabiVida origin that frames your app. With https://app.sabivida.com,
# https://sabivida.com may frame it too.
SABIVIDA_HOST=https://app.sabivida.com
# Your app id, as registered by SabiVida.
MINI_APP_ID=your-app-id
# Staging only (its host is behind an access gate): the staging public keys as
# JSON, and a copy of the SDK you put in public/sdk/v1.js.
# SABIVIDA_JWKS={"keys":[...]}
# SDK_URL=/sdk/v1.js
